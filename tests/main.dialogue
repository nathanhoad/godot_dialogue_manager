import "res://tests/snippets.dialogue" as snippets

#region Main

~ start
Nathan: Testing a snippet.
=>< snippets/snippet
Nathan: ...and back again.
=> END

#endregion

#region Returning to responses

~ snippet_to_responses
=>< snippets/snippet
- First
	Nathan: You picked first.
- Second
	Nathan: You picked second.
Nathan: After responses.
=> END

#endregion
